# Copy to .env and start with: node --env-file=.env src/server.js (npm start reads the environment only).
PORT=3000
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightside
DEMO_MODE=1

# Logs to the fake CloudWatch Logs of Akeso's compose stack:
# DEMO_CLOUDWATCH_ENDPOINT=http://localhost:4566
# ...or to real CloudWatch Logs (leave DEMO_CLOUDWATCH_ENDPOINT unset):
# DEMO_LOG_GROUP=/demo/brightside-coffee
# AWS_PROFILE=brightside-logs
# AWS_REGION=eu-central-1

# The report button:
# AKESO_SERVICE_URL=https://akeso.softup.co
# AKESO_PROJECT_KEY=shpk_...
